<div class="tab mecha" data-tab="mecha">
  <style>
    /* Inline override to force Mecha stats layout (cache-bust / immediate) */
    .tab.mecha .mecha-stats-table { display: table !important; table-layout: fixed !important; width: 100% !important; border-collapse: collapse !important; font-size: 0.85rem !important; }
    .tab.mecha .mecha-stats-table tbody { display: table-row-group !important; }
    .tab.mecha .mecha-stats-table tr { display: table-row !important; }
    .tab.mecha .mecha-stats-table th,
    .tab.mecha .mecha-stats-table td { display: table-cell !important; white-space: nowrap !important; overflow: hidden !important; vertical-align: middle !important; }
    .tab.mecha .mecha-stats-table th { background: #000 !important; color: #fff !important; padding: 6px 8px !important; font-weight: 700 !important; font-size: 0.85rem !important; }
    .tab.mecha .mecha-stats-table td { padding: 4px 6px !important; border: 1px solid #bbb !important; }
  .tab.mecha .mecha-stats-table th:nth-child(1) { width: 28% !important; text-align: left !important; }
  .tab.mecha .mecha-stats-table th:nth-child(2),
  .tab.mecha .mecha-stats-table th:nth-child(3) { width: 16% !important; text-align: center !important; }
  .tab.mecha .mecha-stats-table th:nth-child(4) { width: 18% !important; text-align: center !important; }
  .tab.mecha .mecha-stats-table th:nth-child(5) { width: 22% !important; text-align: center !important; }
  /* Configuration text input - constrained within cell */
  .tab.mecha .mecha-stats-table td input[type="text"] { box-sizing: border-box !important; width: 100% !important; max-width: 100% !important; height: 28px !important; padding: 4px 6px !important; font-size: 0.85rem !important; }
  /* Numeric inputs - wider to better fill cells */
  .tab.mecha .mecha-stats-table td input[type="number"] { box-sizing: border-box !important; display: block !important; margin: 0 auto !important; padding: 4px 6px !important; height: 28px !important; font-size: 0.85rem !important; text-align: center !important; }
  .tab.mecha .mecha-stats-table td:nth-child(2) input[type="number"] { width: 95% !important; max-width: 95% !important; }
  .tab.mecha .mecha-stats-table td:nth-child(3) input[type="number"] { width: 95% !important; max-width: 95% !important; }
  .tab.mecha .mecha-stats-table td:nth-child(4) input[type="number"] { width: 98% !important; max-width: 98% !important; }
  .tab.mecha .mecha-stats-table td:nth-child(5) input[type="number"] { width: 90% !important; max-width: 90% !important; }
  </style>
  <!-- Preset Loader -->
  <div class="preset-loader-row">
    <label>Load Preset</label>
    <select class="preset-select" data-mech="mecha">
      {{#each mechaPresetOptions}}
        <option value="{{this.id}}">{{this.label}}</option>
      {{/each}}
    </select>
    <button type="button" class="load-preset-btn" data-mech="mecha" title="Stamp this preset's servos/armament/shields/movement into this mech (overwrites current loadout)">Load</button>
  </div>

  <div class="mecha-columns">
    <!-- LEFT COLUMN -->
    <div class="mecha-left-col">
      <!-- Mekton Stats -->
      <section class="mecha-stats-section">
        <h3>MEKTON STATS</h3>
        <table class="mecha-stats-table">
          <colgroup>
            <col style="width: 28%" />
            <col style="width: 16%" />
            <col style="width: 16%" />
            <col style="width: 18%" />
            <col style="width: 22%" />
          </colgroup>
          <thead>
            <tr>
              <th>Configuration</th>
              <th>MV</th>
              <th>MR</th>
              <th>Land MA</th>
              <th>Flight MA</th>
            </tr>
          </thead>
          <tbody>
            <tr class="config-row" data-config="1">
              <td><input name="system.mecha.config.name" type="text" value="{{system.mecha.config.name}}" placeholder="Config 1"/></td>
              <td><input class="derived-input" type="number" value="{{system.mecha.config.mv}}" readonly title="Derived from total Kills (Maneuver Value)"/></td>
              <td><input class="derived-input" type="number" value="{{system.mecha.config.mr}}" readonly title="Derived from REF + Maneuver Value"/></td>
              <td><input name="system.mecha.config.landMA" type="number" value="{{system.mecha.config.landMA}}" title="Manual -- book baseline (tonnage only): {{system.derived.mecha.groundMA}} hexes"/></td>
              <td><input name="system.mecha.config.flightMA" type="number" value="{{system.mecha.config.flightMA}}"/></td>
            </tr>
            <tr class="config-row" data-config="2">
              <td><input name="system.mecha.config.name2" type="text" value="{{system.mecha.config.name2}}" placeholder="Config 2"/></td>
              <td><input class="derived-input" type="number" value="{{system.mecha.config.mv2}}" readonly title="Derived from total Kills (Maneuver Value)"/></td>
              <td><input class="derived-input" type="number" value="{{system.mecha.config.mr2}}" readonly title="Derived from REF + Maneuver Value"/></td>
              <td><input name="system.mecha.config.landMA2" type="number" value="{{system.mecha.config.landMA2}}" title="Manual -- book baseline (tonnage only): {{system.derived.mecha.groundMA}} hexes"/></td>
              <td><input name="system.mecha.config.flightMA2" type="number" value="{{system.mecha.config.flightMA2}}"/></td>
            </tr>
            <tr class="config-row" data-config="3">
              <td><input name="system.mecha.config.name3" type="text" value="{{system.mecha.config.name3}}" placeholder="Config 3"/></td>
              <td><input class="derived-input" type="number" value="{{system.mecha.config.mv3}}" readonly title="Derived from total Kills (Maneuver Value)"/></td>
              <td><input class="derived-input" type="number" value="{{system.mecha.config.mr3}}" readonly title="Derived from REF + Maneuver Value"/></td>
              <td><input name="system.mecha.config.landMA3" type="number" value="{{system.mecha.config.landMA3}}" title="Manual -- book baseline (tonnage only): {{system.derived.mecha.groundMA}} hexes"/></td>
              <td><input name="system.mecha.config.flightMA3" type="number" value="{{system.mecha.config.flightMA3}}"/></td>
            </tr>
          </tbody>
        </table>
      </section>

      <!-- Maneuver Pool & Combat Skills Row -->
      <div class="mecha-pool-skills-row">
        <section class="maneuver-pool-section">
          <h3>MANEUVER POOL</h3>
          <input class="pool-input derived-input" type="number" value="{{system.mecha.maneuverPool}}" readonly title="Derived from Mecha Piloting (H) total"/>
          <div class="initmod-row">
            <label class="initmod-label">{{localize 'MF.InitiativeMod'}}</label>
            <input name="system.substats.initiative" type="number" value="{{system.substats.initiative}}" class="pool-input substat-input initmod-input" data-dtype="Number" title="Initiative Modifier (linked to Stats tab)" step="1"/>
          </div>
        </section>

        <section class="cost-multipliers-section">
          <h3>POWERPLANT</h3>
          <div class="multiplier-row">
            <label>Charge</label>
            {{powerplantChargeSelect "system.mecha.powerplant.charge" system.mecha.powerplant.charge}}
          </div>
          <div class="multiplier-row">
            <label>Source</label>
            {{powerplantSourceSelect "system.mecha.powerplant.source" system.mecha.powerplant.source}}
          </div>
          <div class="multiplier-row">
            <label>Hot</label>
            <input type="checkbox" name="system.mecha.powerplant.hot" {{#if system.mecha.powerplant.hot}}checked{{/if}} title="Hot charge variant: higher Explosion Save risk; different cost/combat modifiers"/>
          </div>
          <div class="multiplier-row">
            <label>Explosion Save</label>
            <input class="derived-input" type="number" value="{{system.mecha.powerplant.explosionSave}}" readonly title="D10 roll-or-under to explode when hit, derived from Charge"/>
          </div>
          <div class="multiplier-row">
            <label>Charge Cost Mod</label>
            <input class="derived-input" type="number" value="{{system.mecha.powerplant.chargeCostMod}}" readonly step="0.01" title="Charge's cost multiplier contribution -- included in total Cost"/>
          </div>
          <div class="multiplier-row">
            <label>Source (unverified)</label>
            <input class="derived-input" type="number" value="{{system.derived.mecha.powerplantSourceProvisional}}" readonly title="Source's cost contribution -- NOT yet applied to total Cost; unconfirmed against the book, held until verified"/>
          </div>
          <div class="multiplier-row">
            <label>Other Mult.</label>
            <input name="system.mecha.costMultiplier.other" type="number" value="{{system.mecha.costMultiplier.other}}" step="0.01" title="Manual multiplier value for systems not yet modeled (transformation forms, stealth, etc.) -- included in total Cost"/>
          </div>
        </section>
      </div>

      <section class="combat-skills-section">
        <h3>MECHA COMBAT SKILLS</h3>
        <table class="combat-skills-table">
          <tbody>
            <tr>
              <td class="skill-label">Mecha Piloting</td>
              <td class="skill-mr" title="MR = REF + Maneuver Value (derived)">+ MR= {{system.mecha.config.mr}}</td>
              <td class="skill-total">
                <div class="mecha-skill" data-skill-id="{{mechaSkills.piloting.id}}" data-mech="mecha">
                  <button type="button" class="skill-roll" title="Roll Mecha Piloting"><i class="fas fa-dice-d20"></i></button>
                  <span class="skill-rank">{{mechaSkills.piloting.rank}}</span>
                </div>
              </td>
            </tr>
            <tr>
              <td class="skill-label">Mecha Fighting</td>
              <td class="skill-mr" title="MR = REF + Maneuver Value (derived)">+ MR= {{system.mecha.config.mr}}</td>
              <td class="skill-total">
                <div class="mecha-skill" data-skill-id="{{mechaSkills.fighting.id}}" data-mech="mecha">
                  <button type="button" class="skill-roll" title="Roll Mecha Fighting"><i class="fas fa-dice-d20"></i></button>
                  <span class="skill-rank">{{mechaSkills.fighting.rank}}</span>
                </div>
              </td>
            </tr>
            <tr>
              <td class="skill-label">Mecha Melee</td>
              <td class="skill-mr" title="MR = REF + Maneuver Value (derived)">+ MR= {{system.mecha.config.mr}}</td>
              <td class="skill-total">
                <div class="mecha-skill" data-skill-id="{{mechaSkills.melee.id}}" data-mech="mecha">
                  <button type="button" class="skill-roll" title="Roll Mecha Melee"><i class="fas fa-dice-d20"></i></button>
                  <span class="skill-rank">{{mechaSkills.melee.rank}}</span>
                </div>
              </td>
            </tr>
            <tr>
              <td class="skill-label">Mecha Gunnery</td>
              <td class="skill-mr" title="MR = REF + Maneuver Value (derived)">+ MR= {{system.mecha.config.mr}}</td>
              <td class="skill-total">
                <div class="mecha-skill" data-skill-id="{{mechaSkills.gunnery.id}}" data-mech="mecha">
                  <button type="button" class="skill-roll" title="Roll Mecha Gunnery"><i class="fas fa-dice-d20"></i></button>
                  <span class="skill-rank">{{mechaSkills.gunnery.rank}}</span>
                </div>
              </td>
            </tr>
            <tr>
              <td class="skill-label">Mecha Missiles</td>
              <td class="skill-mr" title="MR = REF + Maneuver Value (derived)">+ MR= {{system.mecha.config.mr}}</td>
              <td class="skill-total">
                <div class="mecha-skill" data-skill-id="{{mechaSkills.missiles.id}}" data-mech="mecha">
                  <button type="button" class="skill-roll" title="Roll Mecha Missiles"><i class="fas fa-dice-d20"></i></button>
                  <span class="skill-rank">{{mechaSkills.missiles.rank}}</span>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </section>

      <!-- Sensors -->
      <section class="sensors-section">
        <h3>SENSORS</h3>
        <table class="sensors-table">
          <thead>
            <tr><th></th><th>Sensor 1</th><th>Sensor 2</th></tr>
          </thead>
          <tbody>
            {{!-- Main and Backup sensors are separate purchases, not exclusive picks --
                 both columns can hold the same Type. --}}
            <tr>
              <td class="sensor-label">Type</td>
              <td>{{sensorTypeSelect "system.mecha.sensors.0.type" system.mecha.sensors.[0].type}}</td>
              <td>{{sensorTypeSelect "system.mecha.sensors.1.type" system.mecha.sensors.[1].type}}</td>
            </tr>
            <tr>
              <td class="sensor-label">Loc</td>
              <td><input type="text" name="system.mecha.sensors.0.loc" value="{{system.mecha.sensors.[0].loc}}"/></td>
              <td><input type="text" name="system.mecha.sensors.1.loc" value="{{system.mecha.sensors.[1].loc}}"/></td>
            </tr>
            <tr>
              <td class="sensor-label">Range</td>
              <td><input type="number" name="system.mecha.sensors.0.range" value="{{system.mecha.sensors.[0].range}}"/></td>
              <td><input type="number" name="system.mecha.sensors.1.range" value="{{system.mecha.sensors.[1].range}}"/></td>
            </tr>
            <tr>
              <td class="sensor-label">Comm</td>
              <td><input type="number" name="system.mecha.sensors.0.comm" value="{{system.mecha.sensors.[0].comm}}"/></td>
              <td><input type="number" name="system.mecha.sensors.1.comm" value="{{system.mecha.sensors.[1].comm}}"/></td>
            </tr>
            <tr>
              <td class="sensor-label">Kills</td>
              <td><input class="derived-input" type="number" value="{{system.mecha.sensors.[0].hits}}" readonly title="Derived from sensor type"/></td>
              <td><input class="derived-input" type="number" value="{{system.mecha.sensors.[1].hits}}" readonly title="Derived from sensor type"/></td>
            </tr>
            <tr>
              <td class="sensor-label">Cost</td>
              <td><input class="derived-input" type="number" value="{{system.mecha.sensors.[0].cost}}" readonly title="Derived from sensor type"/></td>
              <td><input class="derived-input" type="number" value="{{system.mecha.sensors.[1].cost}}" readonly title="Derived from sensor type"/></td>
            </tr>
            <tr>
              <td class="sensor-label">Space</td>
              <td><input class="derived-input" type="number" value="{{system.mecha.sensors.[0].space}}" readonly title="Derived from sensor type"/></td>
              <td><input class="derived-input" type="number" value="{{system.mecha.sensors.[1].space}}" readonly title="Derived from sensor type"/></td>
            </tr>
            <tr>
              <td class="sensor-label">Weight</td>
              <td><input class="derived-input" type="number" value="{{system.mecha.sensors.[0].weightTons}}" readonly title="Derived from sensor type"/></td>
              <td><input class="derived-input" type="number" value="{{system.mecha.sensors.[1].weightTons}}" readonly title="Derived from sensor type"/></td>
            </tr>
          </tbody>
        </table>
      </section>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="mecha-right-col">
      <!-- Mecha Image Area -->
      <section class="mecha-image-area">
        <div class="mecha-image-placeholder" data-action="select-mecha-image" title="Click to select mecha image">
          {{#if system.mecha.imageUrl}}
            <img src="{{system.mecha.imageUrl}}" alt="Mecha"/>
          {{else}}
            <div class="placeholder-text">Click to Add Mecha Image</div>
          {{/if}}
        </div>
      </section>

      <!-- Mekton Profile -->
      <section class="mekton-profile-section">
        <h3>MEKTON PROFILE</h3>
        <table class="profile-table">
          <tr>
            <td class="profile-label">Name</td>
            <td colspan="2"><input name="system.mecha.name" type="text" value="{{system.mecha.name}}"/></td>
            <td class="profile-label">Weight</td>
            <td><input class="derived-input" type="number" value="{{system.mecha.weight}}" readonly title="Total Kills / 2{{#if system.mecha.fuel}} x 1.1 fuel{{/if}}"/></td>
            <td class="profile-label">Fuel</td>
            <td><input type="checkbox" name="system.mecha.fuel" {{#if system.mecha.fuel}}checked{{/if}} title="Book's 10% fuel rule; applied to Weight before MA/flight calc"/></td>
            <td class="profile-label">Cost</td>
            <td><input class="derived-input" type="number" value="{{system.mecha.cost}}" readonly title="Base Cost {{system.derived.mecha.baseCost}} (servos/weapons/shields/sensors/subassembly/movement) x (1 + multiplier sum), per the unified cost engine"/></td>
          </tr>
        </table>
      </section>

      <!-- Subassemblies -->
      <section class="subassemblies-section">
        <h3>SUBASSEMBLIES</h3>
        <table class="cockpit-table">
          <thead>
            <tr><th>Cockpit</th><th># Crew</th><th>Options</th><th>Space</th><th>CP</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>{{cockpitTypeSelect "system.mecha.subassemblies.cockpit.type" system.mecha.subassemblies.cockpit.type}}</td>
              <td><input class="derived-input" type="number" value="{{system.mecha.subassemblies.cockpit.crew}}" readonly title="Derived from cockpit type"/></td>
              <td><input name="system.mecha.subassemblies.cockpit.options" type="text" value="{{system.mecha.subassemblies.cockpit.options}}"/></td>
              <td><input class="derived-input" type="number" value="{{system.mecha.subassemblies.cockpit.space}}" readonly title="Derived from cockpit type"/></td>
              <td><input class="derived-input" type="number" value="{{system.mecha.subassemblies.cockpit.cp}}" readonly title="Derived from cockpit type"/></td>
            </tr>
          </tbody>
        </table>
        <table class="subassemblies-table">
          <thead>
            <tr><th>Subassemblies</th><th>Alarm</th><th>Loc</th><th>Space</th><th>CP</th><th>K</th></tr>
          </thead>
          <tbody>
            {{#each system.mecha.subassemblies.items as |item idx|}}
            <tr>
              <td>{{subassemblyOptionSelect (concat "system.mecha.subassemblies.items." idx ".key") item.key}}</td>
              <td><input type="checkbox" name="system.mecha.subassemblies.items.{{idx}}.variant" {{#if item.variant}}checked{{/if}} title="Anti-theft Code Lock only: adds the audible-alert variant (costMax instead of costMin)"/></td>
              <td>{{mechaLocationSelect (concat "system.mecha.subassemblies.items." idx ".loc") item.loc}}</td>
              <td><input class="derived-input" type="number" value="{{item.space}}" readonly title="Derived from option"/></td>
              <td><input class="derived-input" type="number" value="{{item.cp}}" readonly title="Derived from option"/></td>
              <td><input type="number" name="system.mecha.subassemblies.items.{{idx}}.h" value="{{item.h}}"/></td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </section>

      <!-- Shields -->
      <section class="shields-section">
        <h3>SHIELDS</h3>
        <table class="shields-table">
          <thead>
            <tr><th>Shield</th><th>DA</th><th>SP</th><th>Loc</th><th>Space</th><th>Cost</th><th>Weight</th></tr>
          </thead>
          <tbody>
            {{#each system.mecha.shields as |shield idx|}}
            <tr>
              <td>{{shieldSelect (concat "system.mecha.shields." idx ".key") shield.key}}</td>
              <td><input class="derived-input" type="number" value="{{shield.da}}" readonly title="Derived from shield"/></td>
              <td><input class="derived-input" type="number" value="{{shield.sp}}" readonly title="Derived from shield"/></td>
              <td>{{mechaLocationSelect (concat "system.mecha.shields." idx ".loc") shield.loc}}</td>
              <td><input type="number" name="system.mecha.shields.{{idx}}.space" value="{{shield.space}}"/></td>
              <td><input class="derived-input" type="number" value="{{shield.cost}}" readonly title="Derived from shield"/></td>
              <td><input class="derived-input" type="number" value="{{shield.weightTons}}" readonly title="Derived from shield"/></td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </section>

      <!-- Movement Systems -->
      <section class="movement-section">
        <h3>MOVEMENT SYSTEMS</h3>
        <table class="movement-table">
          <thead>
            <tr><th>Label</th><th>Type</th><th>Target MA</th><th>Loc</th><th>Spc</th><th>CP</th></tr>
          </thead>
          <tbody>
            {{#each system.mecha.movementSystems as |ms idx|}}
            <tr>
              <td><input type="text" name="system.mecha.movementSystems.{{idx}}.system" value="{{ms.system}}" placeholder="e.g. Leg Thruster"/></td>
              <td>{{movementTypeSelect (concat "system.mecha.movementSystems." idx ".type") ms.type}}</td>
              <td><input type="number" name="system.mecha.movementSystems.{{idx}}.targetMA" value="{{ms.targetMA}}" min="0"/></td>
              <td>{{mechaLocationSelect (concat "system.mecha.movementSystems." idx ".loc") ms.loc}}</td>
              <td><input class="derived-input" type="number" value="{{ms.spc}}" readonly title="Derived from final weight + target MA"/></td>
              <td><input class="derived-input" type="number" value="{{ms.cp}}" readonly title="Derived from final weight + target MA (equal to Spc)"/></td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </section>
    </div>
  </div>

  <!-- Bottom Full-Width Servos & Armor -->
  <section class="servos-section">
    <h3>SERVOS & ARMOR</h3>
    <table class="servos-table">
      <thead>
        <tr>
          <th>SP</th>
          <th>Kills</th>
          <th>Servo</th>
          <th>Level</th>
          <th>Extremity</th>
          <th>Space</th>
          <th>Cost</th>
          <th>Armor</th>
          <th>Cost</th>
        </tr>
      </thead>
      <tbody>
        {{!-- Servo rows are a fixed 6-slot array: Head, Torso, R/L Arm, R/L Leg.
             Unrolled (not {{#each}}) because only arm/leg rows get an Extremity picker. --}}
        <tr>
          <td><input class="derived-input" type="number" value="{{system.mecha.servos.[0].sp}}" readonly title="Derived from armor"/></td>
          <td><input class="derived-input" type="number" value="{{system.mecha.servos.[0].hits}}" readonly title="Derived from servo class"/></td>
          <td><input class="derived-input" type="text" value="{{system.mecha.servos.[0].servo}}" readonly/></td>
          <td>{{servoClassSelect "system.mecha.servos.0.level" system.mecha.servos.[0].level}}</td>
          <td></td>
          <td><input class="derived-input" type="text" value="{{system.mecha.servos.[0].space}}" readonly title="Derived from servo class"/></td>
          <td><input class="derived-input" type="number" value="{{system.mecha.servos.[0].cost}}" readonly title="Derived from servo class"/></td>
          <td>{{armorClassSelect "system.mecha.servos.0.armor" system.mecha.servos.[0].armor}}</td>
          <td><input class="derived-input" type="number" value="{{system.mecha.servos.[0].armorCost}}" readonly title="Derived from armor"/></td>
        </tr>
        <tr>
          <td><input class="derived-input" type="number" value="{{system.mecha.servos.[1].sp}}" readonly title="Derived from armor"/></td>
          <td><input class="derived-input" type="number" value="{{system.mecha.servos.[1].hits}}" readonly title="Derived from servo class"/></td>
          <td><input class="derived-input" type="text" value="{{system.mecha.servos.[1].servo}}" readonly/></td>
          <td>{{servoClassSelect "system.mecha.servos.1.level" system.mecha.servos.[1].level}}</td>
          <td></td>
          <td><input class="derived-input" type="text" value="{{system.mecha.servos.[1].space}}" readonly title="Derived from servo class"/></td>
          <td><input class="derived-input" type="number" value="{{system.mecha.servos.[1].cost}}" readonly title="Derived from servo class"/></td>
          <td>{{armorClassSelect "system.mecha.servos.1.armor" system.mecha.servos.[1].armor}}</td>
          <td><input class="derived-input" type="number" value="{{system.mecha.servos.[1].armorCost}}" readonly title="Derived from armor"/></td>
        </tr>
        <tr>
          <td><input class="derived-input" type="number" value="{{system.mecha.servos.[2].sp}}" readonly title="Derived from armor"/></td>
