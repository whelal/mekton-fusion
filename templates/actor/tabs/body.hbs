<div class="tab body" data-tab="body">
  <div class="mf-body-grid mf-body-flex" style="display: flex; gap: 2em; align-items: flex-start;">
    <div class="mf-body-col mf-body-left" style="flex: 1 1 0;">
      <section class="mf-doll">
        <svg class="mf-doll-svg" viewBox="0 0 200 420" aria-label="Paper doll body map">
          <!-- Torso -->
          <rect class="hit-zone torso"   x="70" y="100" width="60" height="90" data-loc="torso" data-zone="torso"><title>Torso (2-4)</title></rect>
          <!-- Head -->
          <circle class="hit-zone head"  cx="100" cy="60" r="22" data-loc="head" data-zone="head"><title>Head (1)</title></circle>
          <!-- Arms -->
          <rect class="hit-zone lArm"    x="38" y="110" width="28" height="70" data-loc="lArm" data-zone="lArm"><title>Left Arm (6)</title></rect>
          <rect class="hit-zone rArm"    x="134" y="110" width="28" height="70" data-loc="rArm" data-zone="rArm"><title>Right Arm (5)</title></rect>
          <!-- Legs: thigh and lower leg are separate armor zones (7/8, 9/10), one body location -->
          <rect class="hit-zone lLeg"    x="78" y="194" width="20" height="44" data-loc="lLeg" data-zone="lThigh"><title>Left Thigh (9)</title></rect>
          <rect class="hit-zone lLeg"    x="78" y="240" width="20" height="44" data-loc="lLeg" data-zone="lLowerLeg"><title>Left Lower Leg (10)</title></rect>
          <rect class="hit-zone rLeg"    x="102" y="194" width="20" height="44" data-loc="rLeg" data-zone="rThigh"><title>Right Thigh (7)</title></rect>
          <rect class="hit-zone rLeg"    x="102" y="240" width="20" height="44" data-loc="rLeg" data-zone="rLowerLeg"><title>Right Lower Leg (8)</title></rect>

          <!-- Item icon placeholders (placed above regions) -->
          <image class="item-icon" data-loc="head"  x="78" y="28" width="44" height="44" href=""/>
          <image class="item-icon" data-loc="torso" x="85" y="120" width="30" height="30" href=""/>
          <image class="item-icon" data-loc="lArm"  x="28" y="120" width="30" height="30" href=""/>
          <image class="item-icon" data-loc="rArm"  x="138" y="120" width="30" height="30" href=""/>
          <image class="item-icon" data-loc="lLeg"  x="74" y="270" width="24" height="24" href=""/>
          <image class="item-icon" data-loc="rLeg"  x="100" y="270" width="24" height="24" href=""/>
        </svg>

        <div class="mf-doll-help">
          <button type="button" class="mf-roll-hitloc" data-action="roll-hitloc">🎯 Roll Hit Location</button>
          <div class="mf-drop-hint">Drop mesh or plate on a zone to cover just that zone, or anywhere else to pick a garment</div>
        </div>
        <!-- Hit Location Table -->
        <div class="mf-hitloc-table">
          <table>
            <thead>
              <tr><th colspan="2">Human Random Hit Chart</th></tr>
              <tr><th>1D10</th><th>Result</th></tr>
            </thead>
            <tbody>
              <tr><td>1</td><td>Head</td></tr>
              <tr><td>2–4</td><td>Torso</td></tr>
              <tr><td>5</td><td>Right Arm</td></tr>
              <tr><td>6</td><td>Left Arm</td></tr>
              <tr><td>7–8</td><td>Right Leg</td></tr>
              <tr><td>9–10</td><td>Left Leg</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
    <div class="mf-body-col mf-body-right" style="flex: 2 1 0;">
      <section class="mf-body-table">
        {{#if isGM}}
        {{!-- GM recovery tools: the character counterpart of mecha Depot Maintenance --}}
        <div class="mf-recovery">
          <button type="button" class="mf-recovery-full" title="Clear every Wound and Bruise (and Sprained) and put out burning; armor unchanged">Full Recovery</button>
          <button type="button" class="mf-recovery-armor" title="Every armor piece back to its base SP on every zone; natural armor back to max; Wounds unchanged">Repair Armor</button>
          <button type="button" class="mf-recovery-rest" title="Heal 1 Bruise per location per full hour; Wounds unchanged">Rest&hellip;</button>
          <button type="button" class="mf-recovery-recover" title="Days of natural recovery: Wounds per MZ's Natural Recovery or Medical Attention table, Bruises per hour rested; previews before applying">Recover&hellip;</button>
        </div>
        {{/if}}
        {{!-- 0.3.30: four facts per location; a row click opens the location editor (owner/GM) --}}
        <table class="mf-table-horizontal mf-body-locations">
          <thead>
            <tr>
              <th>Location</th>
              <th>Armor</th>
              <th>Hits</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {{#each system.body.locations as |loc key|}}
              {{#with (lookup ../bodyArmor key) as |ba|}}
              {{#with (lookup @root.bodyTrack key) as |tr|}}
              <tr class="mf-body-row{{#if @root.bodyEditable}} mf-editable{{/if}}" data-loc="{{key}}"{{#if @root.bodyEditable}} title="Click to edit {{loc.label}}"{{/if}}>
                <td><span class="mf-dot mf-{{key}}"></span>{{loc.label}}</td>
                <td class="mf-armor-cell">
                  {{#each ba.lines as |ln|}}
                    <div class="mf-armor-line">{{#if ln.label}}<small>{{ln.label}}:</small> {{/if}}{{#if ln.none}}&mdash;{{else}}{{ln.name}} {{ln.sp}}/{{ln.spMax}}<span class="mf-sp-bar"><span style="width:{{ln.pct}}%"></span></span>{{/if}}</div>
                  {{else}}
                    <span class="mf-armor-none">&mdash;</span>
                  {{/each}}
                </td>
                <td class="mf-hits-cell">{{{tr.barHtml}}}<span class="mf-hits-text">{{tr.text}}</span></td>
                <td>{{#if tr.badge}}<span class="mf-badge mf-badge-{{tr.state}}" title="{{tr.badgeTitle}}">{{tr.badge}}</span>{{/if}}</td>
              </tr>
              {{/with}}
              {{/with}}
            {{/each}}
          </tbody>
        </table>

        <div class="mf-body-notes">
          <label>{{localize "MF.Notes"}}</label>
          <textarea name="system.body.notes">{{system.body.notes}}</textarea>
        </div>
      </section>
    </div>
  </div>

  <!-- Creature (non-mecha enemy/NPC) -->
  <section class="creature-section">
    <h3>CREATURE</h3>
    <div class="preset-loader-row">
      <label>Load Preset</label>
      <select class="creature-preset-select">
        {{#each creaturePresetOptions}}
          <option value="{{this.id}}">{{this.label}}</option>
        {{/each}}
      </select>
      <button type="button" class="load-creature-preset-btn" title="Stamp this preset's BODY/armor/natural weapons onto this actor (overwrites current values)">Load</button>
    </div>
    <div class="creature-fields-row">
      <label>Body Plan</label>
      {{bodyPlanSelect "system.creature.bodyPlan" system.creature.bodyPlan}}
      <label>Natural Armor SP</label>
      <input type="number" name="system.creature.armorSP" value="{{system.creature.armorSP}}" min="0"/>
    </div>
    <table class="natural-weapons-table">
      <thead><tr><th>Natural Weapon</th><th>Damage</th><th>Type</th></tr></thead>
      <tbody>
        {{#each system.creature.naturalWeapons as |nw idx|}}
        <tr>
          <td><input type="text" name="system.creature.naturalWeapons.{{idx}}.name" value="{{nw.name}}"/></td>
          <td><input type="text" name="system.creature.naturalWeapons.{{idx}}.damage" value="{{nw.damage}}"/></td>
          <td><input type="text" name="system.creature.naturalWeapons.{{idx}}.type" value="{{nw.type}}"/></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </section>
</div>
