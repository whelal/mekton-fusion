  <!-- Bottom Full-Width Space Used by Location (rollup) -->
  <section class="space-summary-section">
    <h3>SPACE USED BY LOCATION</h3>
    <table class="space-summary-table">
      <thead><tr><th>Head</th><th>Torso</th><th>R Arm</th><th>L Arm</th><th>R Leg</th><th>L Leg</th></tr></thead>
      <tbody>
        <tr>
          <td><input class="derived-input" type="number" value="{{system.derived.mecha.spaceByLocation.head.space}}" readonly/></td>
          <td><input class="derived-input" type="number" value="{{system.derived.mecha.spaceByLocation.torso.space}}" readonly/></td>
          <td><input class="derived-input" type="number" value="{{system.derived.mecha.spaceByLocation.rArm.space}}" readonly/></td>
          <td><input class="derived-input" type="number" value="{{system.derived.mecha.spaceByLocation.lArm.space}}" readonly/></td>
          <td><input class="derived-input" type="number" value="{{system.derived.mecha.spaceByLocation.rLeg.space}}" readonly/></td>
          <td><input class="derived-input" type="number" value="{{system.derived.mecha.spaceByLocation.lLeg.space}}" readonly/></td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- Bottom Full-Width Armament -->
  <section class="armament-section">
    <h3>ARMAMENT</h3>
    <table class="armament-table">
      <colgroup>
        <col style="width: 3%" /><col style="width: 8%" /><col style="width: 18%" />
        <col style="width: 5%" /><col style="width: 6%" /><col style="width: 7%" />
        <col style="width: 7%" /><col style="width: 4%" /><col style="width: 4%" />
        <col style="width: 6%" /><col style="width: 5%" /><col style="width: 5%" />
        <col style="width: 6%" /><col style="width: 16%" />
      </colgroup>
      <thead>
        <tr><th>Roll</th><th>Category</th><th>Weapon</th><th>WA</th><th>Range</th><th>Damage</th><th>Shots</th><th>K</th><th>BV</th><th>Loc</th><th>Cost</th><th>Space</th><th>Weight</th><th>Notes</th></tr>
      </thead>
      <tbody>
        {{#each system.mecha.weapons as |weapon idx|}}
        <tr>
          <td><button type="button" class="mecha-weapon-roll" data-idx="{{idx}}" data-mech="mecha" title="Roll {{#if weapon.name}}{{weapon.name}}{{else}}weapon (1d10 + MR + skill + WA){{/if}}"><i class="fas fa-dice-d20"></i></button></td>
          <td>{{weaponCategorySelect (concat "system.mecha.weapons." idx ".category") weapon.category}}</td>
          <td>{{weaponKeySelect (concat "system.mecha.weapons." idx ".weaponKey") weapon.weaponKey weapon.category}}</td>
          <td><input class="derived-input" type="number" value="{{weapon.wa}}" readonly title="Derived from weapon"/></td>
          <td><input class="derived-input" type="text" value="{{weapon.range}}" readonly title="Derived from weapon"/></td>
          <td><input class="derived-input" type="text" value="{{weapon.damage}}" readonly title="Derived from weapon (Kills)"/></td>
          <td><input class="derived-input" type="text" value="{{weapon.shots}}" readonly title="Derived from weapon"/></td>
          <td><input class="derived-input" type="number" value="{{weapon.hits}}" readonly title="Derived from weapon"/></td>
          <td><input class="derived-input" type="text" value="{{weapon.bv}}" readonly title="Burst value, derived from weapon"/></td>
          <td>{{mechaLocationSelect (concat "system.mecha.weapons." idx ".loc") weapon.loc}}</td>
          <td><input class="derived-input" type="number" value="{{weapon.cost}}" readonly title="Derived from weapon"/></td>
          <td><input class="derived-input" type="number" value="{{weapon.space}}" readonly title="Derived from weapon"/></td>
          <td><input class="derived-input" type="number" value="{{weapon.weightTons}}" readonly title="Derived from weapon"/></td>
          <td>
            {{#if weapon.damageNote}}<span class="weapon-damage-note" title="Special rule, derived from weapon">{{weapon.damageNote}}</span>{{/if}}
            <input type="text" name="system.mecha.weapons.{{idx}}.notes" value="{{weapon.notes}}"/>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </section>
</div>
